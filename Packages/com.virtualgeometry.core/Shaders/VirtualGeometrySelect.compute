#pragma kernel Reset
#pragma kernel Select
#pragma kernel CopyDepth
#pragma kernel Downsample
#pragma target 5.0

#define VG_INVALID_NODE 0xffffffffu
#define VG_STACK_CAPACITY 512u

struct VGCluster
{
    float3 BoundsCenter;
    float BoundsRadius;
    uint FirstIndex;
    uint IndexCount;
    uint MaterialSlot;
    uint PageId;
    float GeometricError;
    int Parent;
    uint ChildStart;
    uint ChildCount;
};

struct VGNode
{
    float3 BoundsCenter;
    float BoundsRadius;
    float GeometricError;
    uint FirstCluster;
    uint ClusterCount;
    uint FirstChild;
    uint ChildCount;
    uint PageId;
    uint MaterialSlot;
    uint Level;
    uint LeafStart;
    uint LeafCount;
    uint Reserved0;
    uint Reserved1;
};

struct VGMaterialRange
{
    uint OutputStart;
    uint OutputCapacity;
    uint RootNode;
    uint Reserved;
};

StructuredBuffer<uint> _VGSourceIndices;
StructuredBuffer<VGCluster> _VGClusters;
StructuredBuffer<VGNode> _VGNodes;
StructuredBuffer<VGMaterialRange> _VGMaterialRanges;
StructuredBuffer<uint> _VGPageResidency;
RWStructuredBuffer<uint> _VGVisibleIndices;
RWStructuredBuffer<float4> _VGVisibleDebug;uint _VGDebugMode;
RWStructuredBuffer<uint> _VGRefinementState;
RWStructuredBuffer<uint> _VGSelectionFlags;
RWByteAddressBuffer _VGArguments;
StructuredBuffer<uint4> _VGPageTable;
RWStructuredBuffer<uint> _VGRequests;
uint _VGStreaming;
uint _VGRequestCapacity;

uint _VGMaterialCount;
uint _VGNodeCount;
uint _VGPageCount;
float4x4 _VGObjectToWorld;
float3 _VGCameraPosition;
float _VGMaximumScale;
float _VGProjectionScale;
float _VGNearPlane;
float _VGTargetErrorPixels;
float _VGHysteresis;
uint _VGOrthographic;

RWStructuredBuffer<uint> _VGCullingStatistics;
Texture2D<float> _VGDepthSource;
Texture2D<float> _VGHzbSource;
Texture2D<float> _VGHzb;
RWTexture2D<float> _VGHzbDestination;
float4 _VGScreenSize;
float4 _VGHzbSize;
int _VGSourceMip;
int _VGDestinationMip;
int _VGReversedZ;
int _VGFrustumEnabled;
int _VGOcclusionEnabled;
float _VGDepthBias;
float _VGTextureYSign;
float4x4 _VGViewProjection;
float4 _VGFrustumPlanes[6];

float Farthest(float a,float b)
{
    return _VGReversedZ != 0 ? min(a,b) : max(a,b);
}

[numthreads(8,8,1)]
void CopyDepth(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy >= (uint2)_VGHzbSize.xy)) { return; }
    float depth=_VGReversedZ != 0 ? 0.0 : 1.0;
    if(all(id.xy < (uint2)_VGScreenSize.xy))
    {
        depth=_VGDepthSource.Load(int3(id.xy,0));
    }
    _VGHzbDestination[id.xy]=depth;
}

[numthreads(8,8,1)]
void Downsample(uint3 id:SV_DispatchThreadID)
{
    uint2 size=max(uint2(1,1),(uint2)_VGHzbSize.xy >> _VGDestinationMip);
    if(any(id.xy >= size)) { return; }
    uint2 sourceSize=max(uint2(1,1),(uint2)_VGHzbSize.xy >> _VGSourceMip);
    uint2 p=id.xy*2;
    float a=_VGHzbSource.Load(int3(min(p,sourceSize-1),_VGSourceMip));
    float b=_VGHzbSource.Load(int3(min(p+uint2(1,0),sourceSize-1),_VGSourceMip));
    float c=_VGHzbSource.Load(int3(min(p+uint2(0,1),sourceSize-1),_VGSourceMip));
    float d=_VGHzbSource.Load(int3(min(p+uint2(1,1),sourceSize-1),_VGSourceMip));
    _VGHzbDestination[id.xy]=Farthest(Farthest(a,b),Farthest(c,d));
}

bool OutsideFrustum(float3 center,float radius)
{
    for(uint plane=0;plane<6;plane++)
    {
        if(dot(_VGFrustumPlanes[plane].xyz,center)+_VGFrustumPlanes[plane].w < -radius) { return true; }
    }
    return false;
}

bool Occluded(float3 center,float radius)
{
    // カメラ近傍・near planeとの交差では保守的に描画する。
    if(length(center-_VGCameraPosition) <= radius+_VGNearPlane) { return false; }
    if(dot(_VGFrustumPlanes[4].xyz,center)+_VGFrustumPlanes[4].w <= radius) { return false; }
    float2 uvMin=float2(1,1);
    float2 uvMax=float2(0,0);
    float nearest=_VGReversedZ != 0 ? 0.0 : 1.0;
    for(uint corner=0;corner<8;corner++)
    {
        float3 sign=float3((corner&1) != 0 ? 1.0 : -1.0,(corner&2) != 0 ? 1.0 : -1.0,(corner&4) != 0 ? 1.0 : -1.0);
        float4 clip=mul(_VGViewProjection,float4(center+sign*radius,1));
        if(clip.w <= 0.00001) { return false; }
        float3 ndc=clip.xyz/clip.w;
        float2 uv=float2(ndc.x,ndc.y*_VGTextureYSign)*0.5+0.5;
        uvMin=min(uvMin,uv);uvMax=max(uvMax,uv);
        nearest=_VGReversedZ != 0 ? max(nearest,ndc.z) : min(nearest,ndc.z);
    }
    // 画素境界を1px拡張し、最大2x2 texelに収まるmipから全領域の最遠深度を取得する。
    float2 pixelMin=clamp(uvMin*_VGScreenSize.xy-1,0,_VGScreenSize.xy-1);
    float2 pixelMax=clamp(uvMax*_VGScreenSize.xy+1,0,_VGScreenSize.xy-1);
    float extent=max(pixelMax.x-pixelMin.x,pixelMax.y-pixelMin.y);
    uint mip=(uint)clamp(ceil(log2(max(1.0,extent))),0,_VGHzbSize.z-1);
    uint2 mipSize=max(uint2(1,1),(uint2)_VGHzbSize.xy >> mip);
    uint2 a=min((uint2)floor(pixelMin/exp2((float)mip)),mipSize-1);
    uint2 b=min((uint2)floor(pixelMax/exp2((float)mip)),mipSize-1);
    float depth=Farthest(Farthest(_VGHzb.Load(int3(a,mip)),_VGHzb.Load(int3(b.x,a.y,mip))),
        Farthest(_VGHzb.Load(int3(a.x,b.y,mip)),_VGHzb.Load(int3(b,mip))));
    return _VGReversedZ != 0 ? nearest < depth-_VGDepthBias : nearest > depth+_VGDepthBias;
}

void EmitRequest(uint page,float priority)
{
    if(_VGStreaming==0) { return; }
    uint index;InterlockedAdd(_VGRequests[0],1,index);
    if(index>=_VGRequestCapacity) { InterlockedAdd(_VGRequests[1],1);return; }
    uint start=4+index*4;
    _VGRequests[start]=page;_VGRequests[start+1]=asuint(priority);_VGRequests[start+2]=1;_VGRequests[start+3]=0;
}

// 利用中pageは件数上限で欠落すると未使用に見えて退避されるため、要求queueとは別にpageごとの1組(最大優先度, generation)で返す。
// 正のfloatはuintとして比較しても大小順が保たれる。0は未touchを表すので最小の正値へ切り上げる。
void TouchPage(uint page,float priority)
{
    if(_VGStreaming==0 || page>=_VGPageCount) { return; }
    uint start=4+_VGRequestCapacity*4+page*2;
    InterlockedMax(_VGRequests[start],asuint(max(priority,1.0e-30)));
    _VGRequests[start+1]=_VGPageTable[page].w;
}

bool IsResident(uint pageId)
{
    return pageId < _VGPageCount && _VGPageResidency[pageId] != 0;
}

float ScreenError(VGNode node)
{
    float worldError=node.GeometricError*_VGMaximumScale;
    if(_VGOrthographic != 0)
    {
        return worldError*_VGProjectionScale;
    }
    float3 center=mul(_VGObjectToWorld,float4(node.BoundsCenter,1.0)).xyz;
    float radius=node.BoundsRadius*_VGMaximumScale;
    float distance=max(_VGNearPlane,length(_VGCameraPosition-center)-radius);
    return worldError*_VGProjectionScale/distance;
}

[numthreads(64,1,1)]
void Reset(uint3 id:SV_DispatchThreadID)
{
    uint index=id.x;
    if(index < 4) { _VGCullingStatistics[index]=0; _VGRequests[index]=0; }
    if(_VGStreaming!=0 && index < _VGPageCount)
    {
        uint touch=4+_VGRequestCapacity*4+index*2;
        _VGRequests[touch]=0;_VGRequests[touch+1]=0;
    }
    if(index < _VGNodeCount)
    {
        _VGSelectionFlags[index]=0;
    }
    if(index < _VGMaterialCount)
    {
        VGMaterialRange range=_VGMaterialRanges[index];
        _VGArguments.Store4(index*16,uint4(0,1,range.OutputStart,0));
    }
}

// 各materialは独立した可変長DFSを実行する。DFS(階層の走査・cull・統計・要求)は1 lane(lane 0)が直列に行い、
// 採用したclusterを小さな塊(chunk)としてgroupsharedに溜め、塊ごとにgroupの全lane(VG_SELECT_LANES)で可視indexを並列にコピーする。
// 以前は1 thread/groupで全indexのコピーまで直列に行い、大きなmaterialではこのコピーがGPU時間の大半を占めた。
// 出力する可視indexの並び(cluster順、cluster内はindex順)と、argsの値は変わらない。
#define VG_SELECT_LANES 64u
#define VG_CHUNK_CAPACITY 32u

groupshared uint gsStack[VG_STACK_CAPACITY];
groupshared uint gsChunkCount;
groupshared uint gsState; // 0: 続きがある、1: 走査完了、2: 中断(argsは0にして書き済み)
groupshared uint gsChunkFirstIndex[VG_CHUNK_CAPACITY];
groupshared uint gsChunkIndexCount[VG_CHUNK_CAPACITY];
groupshared uint gsChunkOutput[VG_CHUNK_CAPACITY];
groupshared uint gsChunkPage[VG_CHUNK_CAPACITY];
groupshared float4 gsChunkDebug[VG_CHUNK_CAPACITY];

[numthreads(VG_SELECT_LANES,1,1)]
void Select(uint3 groupId:SV_GroupID,uint lane:SV_GroupIndex)
{
    uint material=groupId.x;
    if(material >= _VGMaterialCount)
    {
        return;
    }

    VGMaterialRange range=_VGMaterialRanges[material];
    if(range.RootNode == VG_INVALID_NODE || range.OutputCapacity == 0)
    {
        return;
    }

    // lane 0 だけが使う走査の状態。pendingNode は clusterOffset 番目から続きを出すnode(chunkが満杯で中断したとき)。
    uint top=0;
    uint writeCount=0;
    uint pendingNode=VG_INVALID_NODE;
    uint clusterOffset=0;
    float pendingScreenError=0;
    if(lane == 0)
    {
        gsStack[top++]=range.RootNode;
    }

    uint state=0;
    [loop]
    for(;;)
    {
        if(lane == 0)
        {
            uint count=0;
            uint result=0;
            [loop]
            while(true)
            {
                if(pendingNode == VG_INVALID_NODE)
                {
                    if(top == 0)
                    {
                        result=1;
                        break;
                    }
                    uint nodeIndex=gsStack[--top];
                    VGNode node=_VGNodes[nodeIndex];
                    if(_VGStreaming!=0 && _VGFrustumEnabled!=0 && OutsideFrustum(mul(_VGObjectToWorld,float4(node.BoundsCenter,1)).xyz,node.BoundsRadius*_VGMaximumScale)) { continue; }

                    bool childrenResident=node.ChildCount > 0;
                    for(uint childOffset=0;childOffset<node.ChildCount && childrenResident;childOffset++)
                    {
                        childrenResident=IsResident(_VGNodes[node.FirstChild+childOffset].PageId);
                    }

                    bool wasRefined=_VGRefinementState[nodeIndex] != 0;
                    float threshold=_VGTargetErrorPixels*(wasRefined ? 1.0-_VGHysteresis : 1.0+_VGHysteresis);
                    float screenError=ScreenError(node);
                    bool wantsRefinement=node.ChildCount>0 && screenError>threshold;
                    bool refine=childrenResident && wantsRefinement && top+node.ChildCount <= VG_STACK_CAPACITY;
                    if(_VGStreaming!=0 && wantsRefinement && !childrenResident) { InterlockedAdd(_VGRequests[2],1); }
                    // 子pageの優先度は、それを必要とする親のscreen errorに揃える(CPU参照: VirtualGeometryLodSelector)。
                    // 誤差は親>=子なので、現在のcutが依存するpageは子孫の要求より低くならず、退避と再要求が振動しない。
                    if(nodeIndex == range.RootNode && IsResident(node.PageId)) { TouchPage(node.PageId,screenError); }
                    if(_VGStreaming!=0 && wantsRefinement)
                    {
                        for(uint childOffset=0;childOffset<node.ChildCount;childOffset++)
                        {
                            uint page=_VGNodes[node.FirstChild+childOffset].PageId;
                            if(IsResident(page)) { TouchPage(page,screenError); }
                            else { EmitRequest(page,screenError); }
                        }
                    }

                    if(refine)
                    {
                        _VGRefinementState[nodeIndex]=1;
                        for(uint childOffset=node.ChildCount;childOffset>0;childOffset--)
                        {
                            gsStack[top++]=node.FirstChild+childOffset-1;
                        }
                        continue;
                    }

                    if(!IsResident(node.PageId))
                    {
                        _VGArguments.Store4(material*16,uint4(0,1,range.OutputStart,0));
                        result=2;
                        break;
                    }

                    _VGRefinementState[nodeIndex]=0;
                    _VGSelectionFlags[nodeIndex]=1;
                    pendingNode=nodeIndex;
                    clusterOffset=0;
                    pendingScreenError=screenError;
                }

                VGNode pending=_VGNodes[pendingNode];
                bool full=false;
                while(clusterOffset < pending.ClusterCount)
                {
                    if(count == VG_CHUNK_CAPACITY)
                    {
                        full=true;
                        break;
                    }
                    VGCluster cluster=_VGClusters[pending.FirstCluster+clusterOffset];
                    uint thisCluster=clusterOffset;
                    clusterOffset++;
                    InterlockedAdd(_VGCullingStatistics[0],1);
                    float3 center=mul(_VGObjectToWorld,float4(cluster.BoundsCenter,1)).xyz;
                    float radius=cluster.BoundsRadius*_VGMaximumScale;
                    if(_VGFrustumEnabled != 0 && OutsideFrustum(center,radius))
                    {
                        InterlockedAdd(_VGCullingStatistics[1],1);
                        continue;
                    }
                    if(_VGOcclusionEnabled != 0 && Occluded(center,radius))
                    {
                        InterlockedAdd(_VGCullingStatistics[2],1);
                        continue;
                    }
                    InterlockedAdd(_VGCullingStatistics[3],1);
                    if(writeCount+cluster.IndexCount > range.OutputCapacity)
                    {
                        _VGArguments.Store4(material*16,uint4(0,1,range.OutputStart,0));
                        result=2;
                        break;
                    }
                    gsChunkFirstIndex[count]=cluster.FirstIndex;
                    gsChunkIndexCount[count]=cluster.IndexCount;
                    gsChunkOutput[count]=range.OutputStart+writeCount;
                    gsChunkPage[count]=cluster.PageId;
                    gsChunkDebug[count]=float4(pending.FirstCluster+thisCluster,pending.Level,pendingScreenError,cluster.PageId);
                    count++;
                    writeCount+=cluster.IndexCount;
                }
                if(result == 2 || full)
                {
                    break;
                }
                pendingNode=VG_INVALID_NODE;
            }
            gsChunkCount=count;
            gsState=result;
        }
        GroupMemoryBarrierWithGroupSync();

        uint chunkCount=gsChunkCount;
        state=gsState;
        if(state != 2)
        {
            for(uint chunk=0;chunk<chunkCount;chunk++)
            {
                uint firstIndex=gsChunkFirstIndex[chunk];
                uint indexCount=gsChunkIndexCount[chunk];
                uint outputStart=gsChunkOutput[chunk];
                uint pageX=0;
                uint pageY=0;
                if(_VGStreaming != 0)
                {
                    uint4 table=_VGPageTable[gsChunkPage[chunk]];
                    pageX=table.x;
                    pageY=table.y;
                }
                for(uint indexOffset=lane;indexOffset<indexCount;indexOffset+=VG_SELECT_LANES)
                {
                    uint outputIndex=outputStart+indexOffset;
                    if(_VGDebugMode>0&&_VGDebugMode<=4){_VGVisibleDebug[outputIndex]=gsChunkDebug[chunk];}
                    _VGVisibleIndices[outputIndex]=_VGSourceIndices[firstIndex+indexOffset+pageY]+pageX;
                }
            }
        }
        // lane 0 が次のchunkを書き始める前に、全laneがコピーを終える。
        GroupMemoryBarrierWithGroupSync();
        if(state != 0)
        {
            break;
        }
    }

    if(lane == 0 && state == 1)
    {
        _VGArguments.Store4(material*16,uint4(writeCount,1,range.OutputStart,0));
    }
}
