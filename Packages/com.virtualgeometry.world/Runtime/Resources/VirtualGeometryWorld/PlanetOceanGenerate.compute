#pragma kernel Generate
#pragma kernel ReduceDepth
#pragma target 5.0

// 惑星の海の Cell 1つ分の頂点を、VirtualGeometryGridLayout の配置で pool の slot へ書く。C# の PlanetOceanSource.TryEvaluateVertexForDiagnostics と同じ式。
// 海面は半径 _Radius の球(PlanetCell.hlsl、Cell の原点からの相対位置)を Gerstner 波(PlanetOcean.hlsl)で動かしたもの。
// 波の位相の端数は CPU が Logical で求める(大きな座標を float にしない)。帯域制限: 波長が 2·_QuadLength より短い成分は変位に入れない。
// UV の x は水深(海面からの地形の深さ。PlanetHeight.hlsl の地形の高さの符号を変えたもの)。

#include "PlanetCell.hlsl"
#include "PlanetHeight.hlsl"
#include "PlanetOcean.hlsl"

float3 Ocean(float a,float b,out float3 direction,out float3 sphere)
{
    SpherePoint(a,b,sphere,direction);
    return sphere+OceanOffset(sphere,direction,_QuadLength);
}

[numthreads(64,1,1)]
void Generate(uint3 id:SV_DispatchThreadID)
{
    int index=(int)id.x;
    if(index >= _SlotVertexCount) { return; }
    int i;
    int j;
    bool skirt;
    GridIndex(index,i,j,skirt);
    float a=(float)i;
    float b=(float)j;
    float3 direction;
    float3 sphere;
    float3 position=Ocean(a,b,direction,sphere);
    float3 unusedDirection;
    float3 unusedSphere;
    float3 du=Ocean(a+1.0,b,unusedDirection,unusedSphere)-Ocean(a-1.0,b,unusedDirection,unusedSphere);
    float3 dv=Ocean(a,b+1.0,unusedDirection,unusedSphere)-Ocean(a,b-1.0,unusedDirection,unusedSphere);
    float3 normal=normalize(cross(dv,du));
    if(skirt)
    {
        position-=direction*_SkirtDepth;
    }
    VGPackedVertex vertex;
    vertex.position=position;
    vertex.normal=normal;
    vertex.uv=float2(-PlanetHeight(sphere,_QuadLength),0);
    _Vertices[_Slot*_SlotVertexCount+index]=vertex;
}

// slot の Cell の頂点のうち、水深(UV の x)が 0 以上(または NaN)のものの数を数えて _NonNegativeCounts[_Slot] に書く。
// 0 なら、全頂点が陸(水深 < 0)で、fragment の clip(depth) が補間した水深でもすべての画素を捨てる(Cell を描いても描かなくても画像が同じ)。
// Generate の直後に、同じ slot(_Slot)で dispatch する(1 group)。
RWStructuredBuffer<uint> _NonNegativeCounts;
groupshared uint sharedCounts[256];

[numthreads(256,1,1)]
void ReduceDepth(uint3 id:SV_GroupThreadID)
{
    uint count=0;
    int first=_Slot*_SlotVertexCount;
    for(int index=(int)id.x;index<_SlotVertexCount;index+=256)
    {
        if(!(_Vertices[first+index].uv.x<0.0)) { count++; }
    }
    sharedCounts[id.x]=count;
    GroupMemoryBarrierWithGroupSync();
    for(uint stride=128;stride>0;stride>>=1)
    {
        if(id.x<stride) { sharedCounts[id.x]+=sharedCounts[id.x+stride]; }
        GroupMemoryBarrierWithGroupSync();
    }
    if(id.x==0) { _NonNegativeCounts[_Slot]=sharedCounts[0]; }
}
