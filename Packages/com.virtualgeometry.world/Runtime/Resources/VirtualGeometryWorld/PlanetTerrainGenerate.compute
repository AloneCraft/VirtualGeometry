#pragma kernel Generate
#pragma target 5.0

// 惑星の Cell 1つ分の頂点を、VirtualGeometryGridLayout の配置で pool の slot へ書く。
// 面の表と等角写像は CubeSphere.cs と同じ。位置は Cell の原点(PlanetCellFrame.Origin、惑星のローカル座標)からの相対位置。
// 大きな値(Cell の原点、中心の正接、ノイズの格子の基点)は CPU が Logical 精度で求めて渡し、
// GPU は Cell の中心からの相対量だけを float で計算する。大きな値どうしの引き算をしないので、
// 誤差は惑星の大きさではなく Cell の大きさに比例する。
// 同じ階層で隣り合う Cell の境界の頂点は、別の中心から求めるので相対誤差 1e-7 程度の差が残りうる(skirt が隠す)。

struct VGPackedVertex
{
    float3 position;
    float3 normal;
    float2 uv;
};

#define MAXIMUM_OCTAVES 20

RWStructuredBuffer<VGPackedVertex> _Vertices;
int _CellQuads;
int _SlotVertexCount;
int _GridVertexCount;
int _Slot;
int _Face;
float _Radius;
float _HeightAmplitude;
float _SkirtDepth;
// 1 quad の、面の角度での大きさ (π/2)/(N·2^L)。
float _QuadAngle;
// 中心の正接 (x0, y0)。
float2 _CenterTangent;
// Cell の面の座標の始点と大きさ(UV 用。深い階層では float の精度で潰れるが、形には使わない)。
float4 _FaceRange;
float _InverseWavelength;
int _Octaves;
// octave ごとの、Cell の原点の格子番号(2^32 で巡回)と端数。
int4 _NoiseLattice[MAXIMUM_OCTAVES];
float4 _NoiseFraction[MAXIMUM_OCTAVES];

static const float3 FaceNormal[6]={float3(1,0,0),float3(-1,0,0),float3(0,1,0),float3(0,-1,0),float3(0,0,1),float3(0,0,-1)};
static const float3 FaceU[6]={float3(0,0,1),float3(0,0,-1),float3(1,0,0),float3(1,0,0),float3(-1,0,0),float3(1,0,0)};
static const float3 FaceV[6]={float3(0,1,0),float3(0,1,0),float3(0,0,1),float3(0,0,-1),float3(0,1,0),float3(0,1,0)};

uint3 Pcg3d(uint3 v)
{
    v=v*1664525u+1013904223u;
    v.x+=v.y*v.z;v.y+=v.z*v.x;v.z+=v.x*v.y;
    v^=v>>16u;
    v.x+=v.y*v.z;v.y+=v.z*v.x;v.z+=v.x*v.y;
    return v;
}

float3 Gradient(int3 cell,uint octave)
{
    uint3 hash=Pcg3d(asuint(cell)+uint3(octave*0x9e3779b9u,octave*0x85ebca6bu,octave*0xc2b2ae35u));
    return normalize(float3(hash&0xffffu)/32767.5-1.0+1e-6);
}

// 3D の gradient noise(値はおよそ −1〜1)。格子番号 i と、その中の位置 f(0〜1)。
float GradientNoise(int3 i,float3 f,uint octave)
{
    float3 w=f*f*f*(f*(f*6.0-15.0)+10.0);
    float n000=dot(Gradient(i+int3(0,0,0),octave),f-float3(0,0,0));
    float n100=dot(Gradient(i+int3(1,0,0),octave),f-float3(1,0,0));
    float n010=dot(Gradient(i+int3(0,1,0),octave),f-float3(0,1,0));
    float n110=dot(Gradient(i+int3(1,1,0),octave),f-float3(1,1,0));
    float n001=dot(Gradient(i+int3(0,0,1),octave),f-float3(0,0,1));
    float n101=dot(Gradient(i+int3(1,0,1),octave),f-float3(1,0,1));
    float n011=dot(Gradient(i+int3(0,1,1),octave),f-float3(0,1,1));
    float n111=dot(Gradient(i+int3(1,1,1),octave),f-float3(1,1,1));
    float x00=lerp(n000,n100,w.x);float x10=lerp(n010,n110,w.x);
    float x01=lerp(n001,n101,w.x);float x11=lerp(n011,n111,w.x);
    return lerp(lerp(x00,x10,w.y),lerp(x01,x11,w.y),w.z)*1.5;
}

// 高さ(m)。球面上の点(Cell の原点からの相対位置 sphere)で fBm を評価し、±_HeightAmplitude に収める
// (bounds の Hmax を保証するため clamp する)。格子は「原点の格子番号 + 相対位置の格子」に分けて、大きな座標を float にしない。
float Height(float3 sphere)
{
    float sum=0;
    float amplitude=0.5;
    for(int octave=0;octave<_Octaves;octave++)
    {
        float3 q=_NoiseFraction[octave].xyz+sphere*(_InverseWavelength*exp2((float)octave));
        float3 whole=floor(q);
        sum+=amplitude*GradientNoise(_NoiseLattice[octave].xyz+(int3)whole,q-whole,(uint)octave);
        amplitude*=0.5;
    }
    return clamp(sum,-1.0,1.0)*_HeightAmplitude;
}

// tan(a0+δ)−tan(a0) を、tan(a0)=x0 と δ から差だけで求める。小さな δ では tan を級数で求める(GPU の tan は小さな値の相対精度が低い)。
float TangentOffset(float x0,float delta)
{
    float t;
    if(abs(delta) < 0.2)
    {
        float d2=delta*delta;
        t=delta*(1.0+d2*(1.0/3.0+d2*(2.0/15.0+d2*(17.0/315.0+d2*(62.0/2835.0)))));
    }
    else
    {
        t=tan(delta);
    }
    return t*(1.0+x0*x0)/(1.0-x0*t);
}

// Cell の中心から格子の番号で (a, b) の位置の、球面上の点(原点からの相対位置)と単位方向。a、b は −1〜N+1。
// R·(p/|p| − p0/|p0|) = R·(d/|p| − p0·(2p0·d + d·d)/(|p|·|p0|·(|p0|+|p|)))、p = p0 + d。
void SpherePoint(float a,float b,out float3 sphere,out float3 direction)
{
    float half=(float)_CellQuads*0.5;
    float x0=_CenterTangent.x;
    float y0=_CenterTangent.y;
    float dx=TangentOffset(x0,(a-half)*_QuadAngle);
    float dy=TangentOffset(y0,(b-half)*_QuadAngle);
    float3 p0=FaceNormal[_Face]+x0*FaceU[_Face]+y0*FaceV[_Face];
    float3 d=dx*FaceU[_Face]+dy*FaceV[_Face];
    float3 p=p0+d;
    float l0=length(p0);
    float l=length(p);
    float3 relative=d/l-p0*((2.0*dot(p0,d)+dot(d,d))/(l*l0*(l0+l)));
    sphere=relative*_Radius;
    direction=p/l;
}

float3 Surface(float a,float b,out float3 direction)
{
    float3 sphere;
    SpherePoint(a,b,sphere,direction);
    return sphere+direction*Height(sphere);
}

[numthreads(64,1,1)]
void Generate(uint3 id:SV_DispatchThreadID)
{
    int index=(int)id.x;
    if(index >= _SlotVertexCount) { return; }
    int side=_CellQuads+1;
    int i;
    int j;
    bool skirt=false;
    if(index < _GridVertexCount)
    {
        i=index%side;
        j=index/side;
    }
    else
    {
        int local=index-_GridVertexCount;
        int edge=local/side;
        int t=local%side;
        i=t;j=t;
        if(edge == 0) { j=0; }
        if(edge == 1) { i=_CellQuads; }
        if(edge == 2) { j=_CellQuads; }
        if(edge == 3) { i=0; }
        skirt=true;
    }
    float a=(float)i;
    float b=(float)j;
    float3 direction;
    float3 position=Surface(a,b,direction);
    float3 unused;
    float3 du=Surface(a+1.0,b,unused)-Surface(a-1.0,b,unused);
    float3 dv=Surface(a,b+1.0,unused)-Surface(a,b-1.0,unused);
    float3 normal=normalize(cross(dv,du));
    if(skirt)
    {
        position-=direction*_SkirtDepth;
    }
    VGPackedVertex vertex;
    vertex.position=position;
    vertex.normal=normal;
    vertex.uv=_FaceRange.xy+float2(a,b)*(_FaceRange.z/(float)_CellQuads);
    _Vertices[_Slot*_SlotVertexCount+index]=vertex;
}
